pragma language_version >= 0.22;

import CompactStandardLibrary;

// -----------------------------------------------------------------------------
// Ledger State (Public, on-chain)
// -----------------------------------------------------------------------------
export ledger min_gpa: Uint<32>;
export ledger max_income: Uint<32>;
export ledger admin: Bytes<32>; // Hash commitment of admin's identity
export ledger nullifiers: Set<Bytes<32>>; // Prevent double claims

// -----------------------------------------------------------------------------
// Private Witnesses (Supplied by the user off-chain)
// -----------------------------------------------------------------------------
struct StudentCredentials {
    gpa: Uint<32>,
    income: Uint<32>,
    student_id: Bytes<32>
}
witness student_credentials(): StudentCredentials;
witness admin_secret_key(): Bytes<32>;

// -----------------------------------------------------------------------------
// Constructor
// -----------------------------------------------------------------------------
constructor(initial_min_gpa: Uint<32>, initial_max_income: Uint<32>, initial_admin: Bytes<32>) {
    min_gpa = disclose(initial_min_gpa);
    max_income = disclose(initial_max_income);
    admin = disclose(initial_admin);
}

// -----------------------------------------------------------------------------
// Core Circuits (ZK proofs)
// -----------------------------------------------------------------------------

// Verifies eligibility based on private credentials without revealing them.
// NOTE: Uint<32> caps at 4,294,967,295. GPA is scaled ×100 (0–1000).
// Client-side UI validation should enforce gpa <= 1000 to save gas.
export circuit verify_eligibility(): [] {
    // 1. Pull private credentials from the witness
    const creds = student_credentials();
    
    // 2. Enforce rules against public ledger thresholds
    assert(creds.gpa > 0, "GPA must be greater than 0");
    assert(creds.income > 0, "Income must be greater than 0");
    assert(creds.gpa >= min_gpa, "GPA too low");
    assert(creds.income <= max_income, "Income too high");
    
    // 3. Generate a nullifier to prevent double-claiming
    const nul = makeNullifier(creds.student_id);
    assert(!nullifiers.member(disclose(nul)), "Already verified");
    
    // 4. Record the nullifier publicly
    nullifiers.insert(disclose(nul));
}

// Allows the admin to update scholarship criteria.
// Requires proof of ownership of the admin_secret_key.
export circuit update_criteria(new_min_gpa: Uint<32>, new_max_income: Uint<32>): [] {
    const sk = admin_secret_key();
    assert(admin == publicKey(sk), "Not authorized");
    
    min_gpa = disclose(new_min_gpa);
    max_income = disclose(new_max_income);
}

// -----------------------------------------------------------------------------
// Helper Circuits
// -----------------------------------------------------------------------------

// Derives a public key hash from a secret key using a specific domain separator.
pure circuit publicKey(sk: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([pad(32, "scholarship:admin:v1"), sk]);
}

// Derives an anonymous nullifier from a student ID.
// Uses a different domain separator to avoid collisions.
pure circuit makeNullifier(student_id: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([pad(32, "scholarship:nullifier:v1"), student_id]);
}
